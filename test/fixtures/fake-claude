#!/usr/bin/env node
// Um Claude Code de mentira, para os testes: fala stream-json pelo stdin e pelo stdout como o de
// verdade (claude -p --input-format stream-json --output-format stream-json).
// Cenários pela mensagem: [edit] uma edição com o diff, [lento] resposta devagar (dá para
// parar), [limite] limite do plano, [rede] erro de conexão, [queda] o processo cai no meio,
// [modelo] responde o modelo, [chave ruim] a OpenRouter recusa a chave (401), [modo] responde o modo de permissão, [pede COMANDO] pede ao Wisp
// (ferramenta approve do servidor MCP dele, como o --permission-prompt-tool) para rodar o
// COMANDO no Bash, [plano] apresenta um plano (ExitPlanMode), [demorado] dois comandos com uma
// pausa entre eles (uma mensagem mandada no meio chega ali, como no CLI de verdade), [agente]
// um subagente com os passos dele, [tarefa] um comando em segundo plano que acaba depois da
// resposta. O resto: uma resposta curta. Com --replay-user-messages, cada mensagem volta quando
// é pega.
// As decisões vão para $HOME/.fake-claude/approvals.log.
// Pedidos de controle: interrupt, set_model (um nome com "naoexiste" é recusado) e
// set_permission_mode. `auth status` diz que há login (FAKE_CLAUDE_LOGGED_OUT=1: não há), e
// `--version`, a versão (FAKE_CLAUDE_VERSION troca).
// Cada processo anota em $HOME/.fake-claude/spawns.log os argumentos e se recebeu a
// ANTHROPIC_API_KEY (e o idioma pedido no prompt do sistema), e em controls.log os pedidos de
// controle.
// A sessão lembra as mensagens de cada turno e o uuid da última resposta dele: [memória]
// responde o que ele lembra, e --resume-session-at <uuid> (com --fork-session, numa sessão nova)
// volta até a resposta com esse uuid, como o de verdade (um uuid desconhecido: erro).
const fs = require('node:fs')
const path = require('node:path')
const args = process.argv.slice(2)
if (args[0] === '--version') {
  console.log(`${process.env.FAKE_CLAUDE_VERSION || '2.1.296'} (Claude Code)`)
  process.exit(0)
}
if (args[0] === 'auth') {
  console.log(
    JSON.stringify({ loggedIn: !process.env.FAKE_CLAUDE_LOGGED_OUT, authMethod: 'claude.ai' })
  )
  process.exit(0)
}
// O e2e de consumo (Fase 23): FAKE_CLAUDE_HOLD_MB segura essa memória, como o Claude Code de
// verdade parado (uns 125 MB de PSS cada, medido no 2.1.296 depois de um turno curto).
const hold = Number(process.env.FAKE_CLAUDE_HOLD_MB) || 0
globalThis.ballast = hold ? Buffer.alloc(hold * 1024 * 1024, 1) : null
const flag = (name) => {
  const i = args.indexOf(name)
  return i >= 0 ? args[i + 1] : null
}
const STATE = path.join(process.env.HOME, '.fake-claude')
const SESSIONS = path.join(STATE, 'sessions')
fs.mkdirSync(SESSIONS, { recursive: true })
const logged = args.filter(
  (a, i) => !['--append-system-prompt', '--settings', '--allowedTools'].includes(args[i - 1])
)
fs.appendFileSync(
  path.join(STATE, 'spawns.log'),
  JSON.stringify({
    pid: process.pid,
    args: logged,
    apiKey: 'ANTHROPIC_API_KEY' in process.env,
    memory: process.env.CLAUDE_CODE_DISABLE_AUTO_MEMORY,
    internal: process.env.WISP_INTERNAL,
    cwd: process.cwd(),
    // O idioma em que o Wisp pede as respostas (Fase 25), pelo prompt do sistema.
    replyIn: /Reply in English/.test(flag('--append-system-prompt') ?? '')
      ? 'en'
      : /Responda em português/.test(flag('--append-system-prompt') ?? '')
        ? 'pt'
        : null,
    // O provedor: pela OpenRouter, o endereço, a chave (só o fim), a pasta e os modelos.
    ...(process.env.ANTHROPIC_BASE_URL
      ? {
          baseUrl: process.env.ANTHROPIC_BASE_URL,
          tokenTail: (process.env.ANTHROPIC_AUTH_TOKEN ?? '').slice(-4),
          apiKeyValue: process.env.ANTHROPIC_API_KEY,
          configDir: process.env.CLAUDE_CONFIG_DIR,
          haiku: process.env.ANTHROPIC_DEFAULT_HAIKU_MODEL,
          subagent: process.env.CLAUDE_CODE_SUBAGENT_MODEL,
          nonessential: process.env.CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC
        }
      : {})
  }) + '\n'
)
const ALIASES = { haiku: 'claude-haiku-5-5', sonnet: 'claude-sonnet-5-5', opus: 'claude-opus-5-5' }
const resolveModel = (m) => (m ? (ALIASES[m] ?? m) : 'claude-sonnet-5-5')
let model = resolveModel(flag('--model'))
let mode = flag('--permission-mode') ?? 'default'
const mcpConfig = flag('--mcp-config')
const newId = flag('--session-id')
const resumeId = flag('--resume')
let sessionId = newId ?? resumeId ?? '00000000-0000-4000-8000-000000000000'
let sessionFile = path.join(SESSIONS, sessionId + '.json')
if (newId && fs.existsSync(sessionFile)) {
  process.stderr.write(`Error: Session ID ${newId} is already in use.\n`)
  process.exit(1)
}
if (resumeId && !fs.existsSync(sessionFile)) {
  process.stderr.write(`No conversation found with session ID: ${resumeId}\n`)
  process.exit(1)
}

// Sem -p, é o modo interativo (o terminal do Wisp): outro programa, no mesmo processo.
if (!args.includes('-p')) {
  require('./fake-claude-tui')({ args, flag, model, mode, sessionId, sessionFile, STATE })
  return
}

// A memória da sessão: o texto que começou cada turno e o uuid da última resposta dele.
const readMemory = (file) => {
  try {
    const saved = JSON.parse(fs.readFileSync(file, 'utf8'))
    return Array.isArray(saved.turns) ? saved.turns : []
  } catch {
    return []
  }
}
let memory = resumeId ? readMemory(sessionFile) : []
const resumeAt = flag('--resume-session-at')
if (resumeAt) {
  const at = memory.findIndex((t) => t.at === resumeAt)
  if (at < 0) {
    process.stderr.write(`No message found with message.uuid of: ${resumeAt}\n`)
    process.exit(1)
  }
  memory = memory.slice(0, at + 1)
}
if (resumeId && args.includes('--fork-session')) {
  sessionId = require('node:crypto').randomUUID()
  sessionFile = path.join(SESSIONS, sessionId + '.json')
}
/** O uuid da última resposta mandada (o fim do turno guarda). */
let lastUuid = null

const out = (event) =>
  process.stdout.write(JSON.stringify({ session_id: sessionId, ...event }) + '\n')
const sleep = (ms) => new Promise((r) => setTimeout(r, ms))
let n = 0
let queue = Promise.resolve()
let current = null
const replay = args.includes('--replay-user-messages')
// Mensagens que chegaram com um turno no meio: entram na próxima pausa entre ferramentas, ou
// viram o turno seguinte.
const inbox = []
const echo = (text) => {
  if (replay)
    out({
      type: 'user',
      isReplay: true,
      message: { role: 'user', content: [{ type: 'text', text }] }
    })
}
/** Uma pausa entre ferramentas: o CLI pega o que chegou no meio. */
const takeInbox = () => {
  const taken = inbox.splice(0)
  taken.forEach(echo)
  return taken
}

async function stream(text, delay = 10) {
  const id = `msg_${++n}`
  out({ type: 'stream_event', event: { type: 'message_start', message: { id } } })
  let sent = ''
  for (const word of text.split(/(?<= )/)) {
    if (current?.aborted) break
    out({
      type: 'stream_event',
      event: { type: 'content_block_delta', index: 0, delta: { type: 'text_delta', text: word } }
    })
    sent += word
    await sleep(delay)
  }
  lastUuid = require('node:crypto').randomUUID()
  out({
    type: 'assistant',
    uuid: lastUuid,
    message: {
      id,
      model,
      content: [{ type: 'text', text: sent }],
      // O contexto da chamada: o que entrou (com o cache) e o que saiu.
      usage: { input_tokens: 1000, cache_read_input_tokens: context - 1050, output_tokens: 50 }
    }
  })
}
function fail(text, error) {
  if (error)
    out({
      type: 'assistant',
      error,
      message: { id: `msg_${++n}`, content: [{ type: 'text', text }] }
    })
  out({ type: 'result', subtype: 'success', is_error: true, result: text })
}
async function tool(name, input, result, toolUseResult) {
  const id = `toolu_${++n}`
  const mid = `msg_${++n}`
  out({ type: 'stream_event', event: { type: 'message_start', message: { id: mid } } })
  out({
    type: 'stream_event',
    event: {
      type: 'content_block_start',
      index: 0,
      content_block: { type: 'tool_use', id, name, input: {} }
    }
  })
  out({
    type: 'assistant',
    message: { id: mid, model, content: [{ type: 'tool_use', id, name, input }] }
  })
  await sleep(20)
  out({
    type: 'user',
    message: {
      role: 'user',
      content: [{ type: 'tool_result', tool_use_id: id, content: result, is_error: false }]
    },
    tool_use_result: toolUseResult
  })
}

// Pede ao Wisp pelo servidor MCP dele, como o --permission-prompt-tool faz.
async function approve(toolName, input, toolUseId) {
  const desktop = JSON.parse(fs.readFileSync(mcpConfig, 'utf8')).mcpServers.desktop
  const res = await fetch(desktop.url, {
    method: 'POST',
    headers: {
      ...desktop.headers,
      'content-type': 'application/json',
      accept: 'application/json, text/event-stream'
    },
    body: JSON.stringify({
      jsonrpc: '2.0',
      id: 1,
      method: 'tools/call',
      params: { name: 'approve', arguments: { tool_name: toolName, input, tool_use_id: toolUseId } }
    })
  })
  const body = await res.text()
  const line = body.split('\n').find((l) => l.startsWith('data:'))
  const message = JSON.parse(line ? line.slice(5) : body)
  const decision = JSON.parse(message.result.content[0].text)
  fs.appendFileSync(
    path.join(STATE, 'approvals.log'),
    `${process.pid} ${desktop.url.split('/').pop()} ${toolName} ${JSON.stringify(input)} ${JSON.stringify(decision)}\n`
  )
  return decision
}
async function askTool(name, input, ok) {
  const id = `toolu_${++n}`
  const mid = `msg_${++n}`
  out({ type: 'stream_event', event: { type: 'message_start', message: { id: mid } } })
  out({
    type: 'stream_event',
    event: {
      type: 'content_block_start',
      index: 0,
      content_block: { type: 'tool_use', id, name, input: {} }
    }
  })
  out({
    type: 'assistant',
    message: { id: mid, model, content: [{ type: 'tool_use', id, name, input }] }
  })
  const decision = await approve(name, input, id)
  const allowed = decision.behavior === 'allow'
  out({
    type: 'user',
    message: {
      role: 'user',
      content: [
        {
          type: 'tool_result',
          tool_use_id: id,
          content: allowed ? ok : decision.message,
          is_error: !allowed
        }
      ]
    }
  })
  return decision
}
function setMode(next) {
  mode = next
  out({ type: 'system', subtype: 'status', status: null, permissionMode: mode })
}

// O contexto da conversa (tokens), que cresce a cada mensagem e cai ao compactar.
let context = 3000

async function compactNow(text, trigger) {
  fs.appendFileSync(path.join(STATE, 'compacts.log'), JSON.stringify({ text, trigger }) + '\n')
  out({ type: 'system', subtype: 'status', status: 'compacting' })
  await sleep(250)
  out({ type: 'system', subtype: 'status', status: null, compact_result: 'success' })
  out({
    type: 'system',
    subtype: 'compact_boundary',
    compact_metadata: { trigger, pre_tokens: context, post_tokens: 4000 }
  })
  context = 4000
  out({
    type: 'user',
    message: { role: 'user', content: 'This session is being continued… (resumo)' }
  })
}

// Um turno; no fim (inclusive com erro), o que chegou no meio e não foi pego vira, cada um, um
// turno, na ordem.
async function turn(text) {
  try {
    await runTurn(text)
  } finally {
    current = null
    for (const next of inbox.splice(0)) queue = queue.then(() => turn(next))
  }
}

async function runTurn(text) {
  current = { aborted: false }
  echo(text)
  fs.writeFileSync(sessionFile, JSON.stringify({ turns: memory }))
  // O /compact do Claude Code: compacta e acaba o turno, sem resposta.
  if (text.startsWith('/compact')) {
    await compactNow(text, 'manual')
    out({
      type: 'user',
      message: { role: 'user', content: '<local-command-stdout>Compacted </local-command-stdout>' }
    })
    out({ type: 'result', subtype: 'success', is_error: false, result: '', num_turns: 0 })
    current = null
    return
  }
  context += text.includes('[grande]') ? 150000 : 30000
  if (text.includes('[cheio]')) await compactNow(text, 'auto')
  out({
    type: 'system',
    subtype: 'init',
    model,
    apiKeySource: 'none',
    permissionMode: mode,
    mcp_servers: [],
    slash_commands: ['compact', 'revisa', 'review', 'init', 'deploy-rapido']
  })
  if (text.includes('[limite]')) {
    const resetsAt = Math.floor(Date.now() / 1000) + 90 * 60
    out({
      type: 'rate_limit_event',
      rate_limit_info: { status: 'rejected', resetsAt, rateLimitType: 'five_hour' }
    })
    return fail(
      `You've hit your limit · resets ${new Date(resetsAt * 1000).toLocaleTimeString('en-US')}`,
      'rate_limit'
    )
  }
  if (text.includes('[rede]')) return fail('API Error: Connection error.', 'unknown')
  if (text.includes('[chave ruim]')) {
    return fail(
      'API Error: 401 {"error":{"message":"User not found.","code":401}}',
      'authentication_failed'
    )
  }
  if (text.includes('[queda]')) {
    await stream('Começando a responder')
    process.stderr.write('FATAL: algo explodiu dentro do CLI\n')
    process.exit(3)
  }
  if (text.includes('[edit]')) {
    await tool(
      'Edit',
      {
        file_path: '/home/u/projeto/src/app.ts',
        old_string: 'const b = 2',
        new_string: 'const b = 3\nconst c = 4'
      },
      'The file /home/u/projeto/src/app.ts has been updated.',
      {
        filePath: '/home/u/projeto/src/app.ts',
        structuredPatch: [
          {
            oldStart: 10,
            oldLines: 3,
            newStart: 10,
            newLines: 4,
            lines: [' const a = 1', '-const b = 2', '+const b = 3', '+const c = 4', ' const d = 5']
          }
        ]
      }
    )
  }
  let answer = 'Oi! Tudo certo por aqui.'
  let delay = 10
  if (text.includes('[demorado]')) {
    await tool('Bash', { command: 'sleep 1', description: 'Espera um pouco' }, '')
    await sleep(1500)
    const seen = takeInbox()
    await tool('Bash', { command: 'sleep 1', description: 'Espera mais' }, '')
    if (seen.length) answer = `Vi no meio do caminho: ${seen.join(' | ')}.`
  }
  if (text.includes('[agente]')) {
    const id = `toolu_${++n}`
    const input = {
      description: 'Procurar o bug',
      prompt: 'Ache o bug',
      subagent_type: 'general-purpose'
    }
    out({
      type: 'assistant',
      message: {
        id: `msg_${++n}`,
        model,
        content: [{ type: 'tool_use', id, name: 'Agent', input }]
      }
    })
    const steps = [
      ['Read', { file_path: '/home/u/projeto/src/app.ts' }],
      ['Grep', { pattern: 'contador' }]
    ]
    for (const [name, stepInput] of steps) {
      const step = `toolu_${++n}`
      out({
        type: 'assistant',
        parent_tool_use_id: id,
        message: {
          id: `msg_${++n}`,
          model,
          content: [{ type: 'tool_use', id: step, name, input: stepInput }]
        }
      })
      await sleep(300)
      out({
        type: 'user',
        parent_tool_use_id: id,
        message: {
          role: 'user',
          content: [{ type: 'tool_result', tool_use_id: step, content: 'ok' }]
        }
      })
    }
    out({
      type: 'user',
      message: {
        role: 'user',
        content: [{ type: 'tool_result', tool_use_id: id, content: 'Achei o bug.' }]
      }
    })
    answer = 'O subagente achou o bug.'
  }
  if (text.includes('[tarefa]')) {
    const task = `task_${++n}`
    out({
      type: 'system',
      subtype: 'task_started',
      task_id: task,
      description: 'npm run dev',
      is_backgrounded: true,
      task_type: 'local_bash'
    })
    setTimeout(
      () =>
        out({
          type: 'system',
          subtype: 'task_notification',
          task_id: task,
          status: 'completed',
          summary: 'npm run dev'
        }),
      2500
    )
    answer = 'Deixei o servidor rodando.'
  }
  if (text.includes('[lento]')) {
    answer =
      'Esta resposta vem bem devagar, palavra por palavra, para dar tempo de parar no meio dela.'
    delay = 150
  }
  const asked = /\[pede ([^\]]+)\]/.exec(text)
  if (asked) {
    const decision = await askTool(
      'Bash',
      { command: asked[1], description: 'Comando de teste' },
      `saída de ${asked[1]}`
    )
    answer = decision.behavior === 'allow' ? `Rodei ${asked[1]}.` : `Não rodei ${asked[1]}.`
  }
  if (text.includes('[plano]')) {
    const decision = await askTool(
      'ExitPlanMode',
      { plan: '# Plano\n\n1. Ler o código\n2. **Mudar** o arquivo', planFilePath: '/tmp/plano.md' },
      'Plano aprovado.'
    )
    if (decision.behavior === 'allow') {
      const change = decision.updatedPermissions?.find((p) => p.type === 'setMode')
      setMode(change ? change.mode : 'default')
      answer = `Plano aprovado; modo ${mode}.`
    } else answer = 'Vou continuar planejando.'
  }
  if (text.includes('[modelo]')) answer = `Modelo: ${model}`
  if (text.includes('[memória]')) {
    answer = `Lembro de: ${[...memory.map((t) => t.user), text].join(' | ')}`
  }
  if (text.includes('[modo]')) answer = `Modo: ${mode}`
  await stream(answer, delay)
  if (current.aborted) {
    out({
      type: 'user',
      message: { role: 'user', content: [{ type: 'text', text: '[Request interrupted by user]' }] }
    })
    out({
      type: 'result',
      subtype: 'error_during_execution',
      is_error: true,
      terminal_reason: 'aborted_streaming'
    })
  } else {
    memory.push({ user: text, at: lastUuid })
    fs.writeFileSync(sessionFile, JSON.stringify({ turns: memory }))
    out({
      type: 'result',
      subtype: 'success',
      is_error: false,
      result: answer,
      usage: { input_tokens: 1000, output_tokens: 50, cache_read_input_tokens: 2000 },
      modelUsage: { [model]: { contextWindow: 200000 } }
    })
  }
}

function control({ request_id, request }) {
  fs.appendFileSync(
    path.join(STATE, 'controls.log'),
    JSON.stringify({ pid: process.pid, ...request }) + '\n'
  )
  const ok = () => out({ type: 'control_response', response: { subtype: 'success', request_id } })
  const error = (message) =>
    out({ type: 'control_response', response: { subtype: 'error', request_id, error: message } })
  if (request.subtype === 'interrupt') {
    if (current) current.aborted = true
    ok()
  } else if (request.subtype === 'set_model') {
    if (/naoexiste/.test(request.model ?? '')) return error(`Model '${request.model}' not found`)
    model = resolveModel(request.model)
    ok()
  } else if (request.subtype === 'set_permission_mode') {
    if (request.mode === 'bypassPermissions')
      return error('Cannot set permission mode to bypassPermissions')
    ok()
    setMode(request.mode)
  }
}

let buffer = ''
process.stdin.setEncoding('utf8')
process.stdin.on('data', (chunk) => {
  buffer += chunk
  let i
  while ((i = buffer.indexOf('\n')) >= 0) {
    const line = buffer.slice(0, i)
    buffer = buffer.slice(i + 1)
    if (!line.trim()) continue
    const message = JSON.parse(line)
    if (message.type === 'control_request') {
      control(message)
      continue
    }
    if (message.type !== 'user') continue
    const text = message.message.content.map((b) => b.text ?? '').join('')
    // Com um turno no meio, a mensagem espera a próxima pausa; o que sobrar vira o turno seguinte.
    if (current) inbox.push(text)
    else queue = queue.then(() => turn(text))
  }
})
process.stdin.on('end', () => queue.then(() => process.exit(0)))
